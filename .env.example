# این فایل فقط نمونه است — برای اجرای واقعی روی GitHub Actions، این مقادیر را
# در قسمت Settings -> Secrets and variables -> Actions همان ریپازیتوری وارد کنید،
# نه در این فایل (این فایل هرگز نباید مقدار واقعی توکن‌ها را داشته باشد).

# --- الزامی (Secrets) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=@your_channel_username_or_numeric_chat_id

# --- اختیاری (Secret) — اگر خالی بماند، به‌جای بازنویسی با هوش مصنوعی،
#     یک خبر حداقلیِ ساخته‌شده از فیلدهای واقعی کدال فرستاده می‌شود ---
GEMINI_API_KEY=

# --- اختیاری (Variables) ---
GEMINI_MODEL=gemini-3.1-flash-lite
CODAL_API_BASE=https://search.codal.ir/api/search/v2/q
MAX_ITEMS_PER_RUN=25
SEND_IMAGE=true
SYMBOLS_FILTER=
SEED_ONLY=false
